<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppLogin.Views.Login"
             Title="Login">
    <VerticalStackLayout Margin="10" Spacing="10" VerticalOptions="CenterAndExpand">
        <Label Text="Tinder Blue" FontSize="Title"/>
        
        <Label Text="E-mail"/>
        <Entry x:Name="txt_email" Keyboard="Email"></Entry>
        
        <Label Text="Senha:"/>
        <Entry x:Name="txt_senha" Keyboard="Password"></Entry>

        <Button Text="Entrar" Clicked="Button_Clicked"></Button>
        
    </VerticalStackLayout>
</ContentPage>