<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             BackgroundColor="{StaticResource Gray100}">
    
    <VerticalStackLayout>
        
        <Label 
            Text="{Binding QuartoSelecionado.Descricao}"
            TextColor="{StaticResource Primary}"
            FontFamily="TheBandit"
            FontSize="50"
            HorizontalTextAlignment="Center" />

        <Border StrokeShape="RoundRectangle 10">
            <Grid RowDefinitions="Auto" ColumnDefinitions="*, *, *, *">
                
                <Label Grid.Row="0" Grid.Column="0" Text="Adultos:"></Label>
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding QntAdultos}"></Label>

                <Label Grid.Row="0" Grid.Column="2" Text="Crianças:"></Label>
                <Label Grid.Row="0" Grid.Column="3" Text="{Binding QntCriancas}"></Label>
            </Grid>
        </Border>

        <Border StrokeShape="RoundRectangle 10">
            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *, *">
                <Label Grid.Row="0" Grid.Column="0" Text="Data Check-in:"></Label>
                <Label Grid.Row="1" Grid.Column="0" Text="{Binding DataCheckin}"></Label>

                <Label Grid.Row="0" Grid.Column="1" Text="Data Check-out:"></Label>
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckout}"></Label>

                <Label Grid.Row="0" Grid.Column="2" Text="Estadia:"></Label>
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Estadia}"></Label>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentPage>