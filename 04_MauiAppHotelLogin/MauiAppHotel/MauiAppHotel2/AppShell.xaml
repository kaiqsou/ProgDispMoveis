<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppHotel2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiAppHotel2"
    xmlns:views="clr-namespace:MauiAppHotel2.Views"
    Title="MauiAppHotel2">

    <ShellContent
        ContentTemplate="{DataTemplate views:Login}"
        Route="Login" />

    <ShellContent
        ContentTemplate="{DataTemplate views:Contratacao}"
        Route="Contratacao" />

</Shell>
