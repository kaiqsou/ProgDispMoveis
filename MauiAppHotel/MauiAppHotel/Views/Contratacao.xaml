<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Contratacao"
             BackgroundColor="{StaticResource SpeedBlue}">

    <!-- Container Geral da Tela -->
    <VerticalStackLayout>
        <Label Text="Cálculo da Diária" FontFamily="TheBandit" FontSize="Large"></Label>
        
        <!-- Container das Pessoas e Quartos -->
        <Border Padding="10">
            <VerticalStackLayout>
            <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Adultos:"/>
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Value}" 
                       BindingContext="{x:Reference stp_adultos}"/>
                <Stepper Grid.Row="0" Grid.Column="2" x:Name="stp_adultos"
                         Minimum="0" Maximum="10" Increment="1"/>
            </Grid>
            </VerticalStackLayout>
        </Border>
        
    </VerticalStackLayout>
</ContentPage>